# Copy this file to .env.local and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives consultation and academy enquiries.
ENQUIRY_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend (e.g. enquiries@beyoubyemi.com).
# Until your domain is verified, use Resend's test sender below — it can only
# deliver to the email address you signed up to Resend with.
ENQUIRY_FROM_EMAIL="BEYOU by Emi <onboarding@resend.dev>"

# Public URL of the live site, no trailing slash (used for SEO and share previews).
NEXT_PUBLIC_SITE_URL=https://beyoubyemi.com
